SIZE = 5
queue = [0] * SIZE
front = -1
rear = -1

def enqueue(item):
    global front, rear

    if rear == SIZE - 1:
        print("Queue Overflow")
    else:
        if front == -1:
            front = 0
        rear += 1
        queue[rear] = item
        print(item, "inserted into queue")

def dequeue():
    global front, rear

    if front == -1 or front > rear:
        print("Queue Underflow")
    else:
        print(queue[front], "deleted from queue")
        front += 1
        if front > rear:
            front = rear = -1

def display():
    if front == -1:
        print("Queue is Empty")
    else:
        print("Queue Elements:")
        for i in range(front, rear + 1):
            print(queue[i], end=" ")
        print()

while True:
    print("\n----- QUEUE OPERATIONS -----")
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        item = int(input("Enter element: "))
        enqueue(item)

    elif choice == 2:
        dequeue()

    elif choice == 3:
        display()

    elif choice == 4:
        print("Program Ended")
        break

    else:
        print("Invalid Choice")
